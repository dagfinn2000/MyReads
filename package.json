{
  "name": "myreads",
  "version": "2.2.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "description": "Personal self-hosted library and reading tracker",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.config.db.ts",
    "test:db:docker": "scripts/with-test-db.sh npm run test:db",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:prune": "node --env-file-if-exists=.env scripts/prune-metadata-cache.mjs",
    "covers:prune": "node --env-file-if-exists=.env scripts/prune-covers.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-auth": "^5.0.0-beta.32",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.2.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
