// MyReads data model.
//
// Design note: reading data (status, rating, review, dates) lives directly on
// Book rather than in a separate "reading entry" model. Every book row already
// belongs to exactly one user in this single-purpose app, so a join table
// would only add indirection.

generator client {
  provider = "prisma-client-js"
  // "native" covers local dev (Windows/macOS/Linux glibc); the musl target is
  // what the Alpine-based Docker image needs at runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReadingStatus {
  WANT_TO_READ
  READING
  READ
  DNF // did not finish
}

enum BookFormat {
  PHYSICAL
  EBOOK
  AUDIOBOOK
}

/// Where a book physically stands in relation to you. This replaced a single
/// `owned` boolean, which had to mean both "on my shelf" and — when false —
/// "on the wishlist". That left nowhere to record the two states a real
/// shelf produces: a book borrowed from someone else, and one you read and
/// no longer have. Both used to be forced into the wishlist.
enum BookOwnership {
  OWNED
  WISHLIST
  /// Someone else's copy, currently with you.
  BORROWED
  /// Read it, but it's gone — sold, donated, or lost.
  GIVEN_AWAY
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String // bcrypt
  /// Bumped whenever every existing session should stop working — currently
  /// a password change. Sessions are JWTs with no server-side row to delete,
  /// so the token carries the value it was minted with and `auth.ts` rejects
  /// it once the two disagree. Tokens minted before this column existed have
  /// no value at all and are treated as 0, so upgrading doesn't sign anyone
  /// out; the first password change invalidates them like any other.
  tokenVersion Int           @default(0)
  /// Chosen UI theme (id from lib/themes.ts), so the look follows the
  /// account across browsers. Null = never picked one on this account;
  /// the client falls back to localStorage, then the default.
  theme        String?
  /// Preferred library view ({ sort, dir, group } — see lib/library-view.ts),
  /// applied when /books is opened without explicit view params so the
  /// chosen sort survives navigating away and back. Null = defaults.
  libraryView  Json?
  /// Everything set in the Preferences card on the Account page (see
  /// lib/preferences.ts): defaults for new books, date and number formats,
  /// time zone, sorting rules, catalogues, rating style and so on. One JSON
  /// column rather than a column per setting, so adding a setting needs no
  /// migration — parsePreferences fills in a default for anything missing.
  /// Null = never changed anything.
  preferences  Json?
  /// When this account last downloaded its backup zip (GET /api/export), so
  /// the Backup card can say how old the newest copy is. Null = never.
  lastBackupAt DateTime?
  createdAt    DateTime      @default(now())
  books        Book[]
  shelves      Shelf[]
  readingGoals ReadingGoal[]
  savedViews   SavedView[]
}

/// A library view saved under a name ("Unread fantasy"): the filters, sort
/// and grouping exactly as they appear in the /books address. Shown as chips
/// above the library; Preferences can make one the view the library opens on.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  /// The /books query string, rebuilt from the parsed filters so only known
  /// parameters are ever stored (see lib/saved-views.ts).
  query     String
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

enum GoalUnit {
  BOOKS
  PAGES
}

/// A yearly reading goal ("24 books in 2026", or "8,000 pages"). Progress is
/// derived from the books finished in that year (see lib/goals.ts); hitting
/// the target earns a gold medal on the stats page.
model ReadingGoal {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year         Int
  target       Int
  /// What `target` counts: finished books, or the pages of finished books.
  unit         GoalUnit @default(BOOKS)
  /// Whether finishing a book again counts. False = only books finished for
  /// the first time that year.
  countRereads Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, year])
}

/// A user-defined shelf ("Sanderson", "Fantasy") — freeform grouping
/// independent of reading status. Books can sit on many shelves at once;
/// deleting a shelf only removes the grouping, never the books.
model Shelf {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  books     Book[]

  @@unique([userId, name])
}

model Book {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- bibliographic data ---
  title         String
  authors       String[]   @default([])
  isbn          String?
  description   String?
  /// Either a local cached path ("/api/covers/<id>.jpg") or a remote URL.
  coverUrl      String?
  pageCount     Int?
  /// Running time of an audiobook, in minutes, so progress can be logged as
  /// time listened. Positions are still stored as the matching page of
  /// pageCount, so stats never need to know about it. Null = not known.
  lengthMinutes Int?
  /// Kept as a string because metadata APIs return partial dates ("1999", "2003-07").
  publishedDate String?
  tags          String[]   @default([])
  format        BookFormat @default(PHYSICAL)
  ownership     BookOwnership @default(OWNED)
  /// Freeform series name (e.g. "Mistborn Era 1"); groups books together.
  seriesName    String?
  /// Position in the series. Float so novellas can slot in at 1.5.
  seriesNumber  Float?
  shelves       Shelf[]
  /// Open Library work ID (e.g. "OL45883W") when imported via search.
  openLibraryId String?

  // --- personal reading data ---
  status       ReadingStatus @default(WANT_TO_READ)
  /// 1–10 in half-star units: 7 = 3.5 stars. Null = unrated.
  rating       Int?
  review       String?
  dateStarted  DateTime?
  dateFinished DateTime?
  timesRead    Int           @default(0)
  /// Where you are in the book right now. Kept for READING and DNF
  /// ("stopped at p. 218"); cleared when the book is finished or reshelved.
  currentPage  Int?

  /// Denormalized lowercase "title + authors" so search can be a single
  /// case-insensitive `contains` (Prisma can't substring-search String[]).
  searchText String @default("")
  /// The review, folded the same way (foldForSearch), for readers who search
  /// reviews too; "" without one. Written wherever review is, never sent to
  /// the browser or into a backup.
  reviewSearchText String @default("")

  quotes   Quote[]
  reads    Read[]
  progress ProgressEntry[]
  loans    Loan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  /// Year pages and per-year stats filter and sort on finish date.
  @@index([userId, dateFinished])
  /// "Do I own this?" matches by ISBN in both 10- and 13-digit forms.
  @@index([userId, isbn])
  /// Tag filter uses array containment, which a btree cannot serve.
  @@index([tags], type: Gin)
  /// Library search is a substring match (LIKE '%…%'); the series lookup is
  /// ILIKE. Both need trigrams — see the 20260728020000 migration.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Book_searchText_trgm_idx")
  @@index([seriesName(ops: raw("gin_trgm_ops"))], type: Gin, map: "Book_seriesName_trgm_idx")
}

/// A *past* completed pass through a book. The Book row itself always holds
/// the latest read (status, dates, rating), so re-reading archives the
/// previous pass here. `timesRead` on Book is kept in sync as
/// `reads.count + (status == READ ? 1 : 0)` — see lib/actions/reads.ts.
model Read {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  /// Both dates optional: "I know I read this in 2019" is a valid entry,
  /// and so is a fully undated "read it before" placeholder.
  dateStarted  DateTime?
  dateFinished DateTime?
  /// What you rated it *that* time, 1–10 half-star units. Null = unrated;
  /// the Book row's rating stays your current overall rating.
  rating Int?
  /// What you thought that time, or how you read it ("read it aloud to the
  /// kids"). Optional, kept with the pass's dates and rating.
  note   String?

  createdAt DateTime @default(now())

  @@index([bookId, dateFinished])
}

/// A point-in-time reading position: "on this date I was at page N".
/// Logged automatically whenever `currentPage` changes, so the reading log
/// costs no extra effort. Powers the progress sparkline, pace/forecast, and
/// the reading-days heatmap. Pages-read-per-day is always the *delta between
/// consecutive entries* of a book — a lone first entry contributes nothing,
/// which is what makes anchors work: the upgrade migration seeds mid-read
/// books with their current position, and each new reading pass starts with
/// a page-0 anchor at the pass start (see logProgress in lib/actions/books.ts
/// and readAgain in lib/actions/reads.ts; the latest page-0 entry is the
/// pass boundary — see currentPassEntries in lib/progress.ts).
model ProgressEntry {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  page Int
  date DateTime @default(now())

  @@index([bookId, date])
}

/// A copy of this book lent to someone. An open loan (`returnedAt` null) is
/// what makes a book "lent out"; returning one keeps the row as history, so
/// the book page can show who has borrowed it over the years.
///
/// Deliberately about *your* copy going out, not about books you borrowed —
/// that's `ownership = BORROWED` on the book itself.
model Loan {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  /// Freeform: a name, "the book club", whatever identifies where it went.
  borrower   String
  lentAt     DateTime  @default(now())
  /// Null while the book is still out.
  returnedAt DateTime?
  note       String?

  createdAt DateTime @default(now())

  /// Finding open loans, and listing a book's history newest-first.
  @@index([bookId, returnedAt])
  @@index([bookId, lentAt])
}

/// A favourite quote or highlight from a book, with an optional page
/// reference and a personal note on why it stuck. Ownership is derived
/// through the book (books are per-user).
model Quote {
  id     String @id @default(cuid())
  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  text String
  page Int?
  note String?

  createdAt DateTime @default(now())

  @@index([bookId])
  /// Quotes are always read newest-first within a book.
  @@index([bookId, createdAt])
}

/// Caches raw Open Library / Google Books responses so repeated lookups of the
/// same query don't hit the external APIs. Rows are upserted per (source,
/// query) and considered stale after `expiresAt`.
model MetadataCache {
  id        String   @id @default(cuid())
  source    String // "ol-search" | "ol-work" | "gb-volume"
  query     String // normalized (lowercased, trimmed) lookup key
  payload   Json
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@unique([source, query])
}
