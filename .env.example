# ---------------------------------------------------------------------------
# MyReads environment configuration
# Copy to .env and fill in the values. Every variable used by the app is
# documented here; docker-compose.yml reads this file automatically.
# ---------------------------------------------------------------------------

# --- Postgres (used by the `db` service in docker-compose) ---
POSTGRES_USER=myreads
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=myreads

# --- App: database connection ---
# Only used when running the app or the prisma CLI OUTSIDE Docker (local
# dev). Inside Docker, docker-compose assembles DATABASE_URL from the
# POSTGRES_* values above, pointing at the `db` service.
DATABASE_URL=postgresql://myreads:change-me-to-something-random@localhost:5432/myreads

# --- Auth.js ---
# Secret used to sign/encrypt session JWTs. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=generate-a-random-32-byte-base64-string

# Required when running behind a host Auth.js doesn't know about (i.e. any
# self-hosted deployment). Leave as true.
AUTH_TRUST_HOST=true

# How many reverse proxies sit between this app and the internet. The login
# and registration rate limits key on the client address, which is read from
# the X-Forwarded-For header — a header the client itself can set. Only the
# rightmost entries are appended by your own infrastructure, so this says how
# many to count back.
#
#   1 (default)  the usual single nginx/Caddy/Traefik in front
#   2            proxy behind a CDN or a second load balancer
#
# Too high trusts the client again; too low keys every request on your own
# proxy's address and throttles all users as one pool. If the app is exposed
# directly with no proxy, the header is absent and this is unused.
TRUSTED_PROXY_HOPS=1

# --- Metadata fetching ---
# Optional. When set, Google Books is used to enrich Open Library results
# (descriptions and page counts are often better). The app works fully
# without it.
GOOGLE_BOOKS_API_KEY=

# --- Cover image cache ---
# Directory where imported cover images are stored. The Docker image sets
# this to /app/data/covers (backed by a named volume); for local dev the
# default ./data/covers is used if unset.
COVERS_DIR=

# Cover images are downloaded server-side from whatever URL a book carries,
# so by default the app refuses to fetch private, loopback and link-local
# addresses — otherwise a pasted URL could be used to probe your LAN or a
# cloud metadata endpoint. Set to "true" only if you deliberately host cover
# images on the same private network as this instance.
COVER_FETCH_ALLOW_PRIVATE=false

# --- Nightly backups on the server ---
# Once a day the server saves a backup zip of every account (the same file
# Download backup on the Account page makes) and keeps the newest few, so
# a lost or broken database never means a lost library. Each reader sees
# and downloads their own copies on the Backup card. They are written to
#   <BACKUP_DIR>/<account id>/myreads-backup-YYYY-MM-DD.zip
# docker-compose turns them on, with BACKUP_DIR=/app/data/backups in the
# `backups` volume. Outside Docker they are off unless you set BACKUP_DIR
# to a folder the app can write to.
BACKUP_DIR=

# The hour of the day the copies are made, 0-23, on the server's clock
# (UTC in Docker). The Backup card shows it in each reader's own time.
# Default 3.
BACKUP_HOUR=3

# How many copies to keep for each account, 1-365; older ones are deleted.
# Default 7, a week's worth.
BACKUP_KEEP=7

# --- Reading reminders ---
# Readers can turn on a daily notification at a time they choose, in any
# browser (Preferences > Reading reminders). The server sends them through
# each browser's own push service (Google's, Mozilla's, Apple's), signed
# with a key it makes itself the first time and keeps in the database, so
# there is nothing to set up. Browsers only allow them on a site opened
# over https (or on localhost). Set to "off" to turn them off.
READING_REMINDERS=on

# Who push services can contact about this server's reminders: a mailto:
# or https: address. Optional; the default is the MyReads project page.
VAPID_SUBJECT=

# --- Registration ---
# Set to "true" to disable new-account registration after you've created
# your own account (nice hardening for an internet-exposed instance).
DISABLE_REGISTRATION=false

# --- App port (docker-compose only) ---
# Host port the app is published on. Optional; defaults to 3000.
APP_PORT=3000
